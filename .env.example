APP_NAME=GalangKita
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Lokal: sqlite/mysql. Modul 7: pgsql (Supabase Session pooler 5432; di Vercel Transaction pooler 6543)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=galangkita
DB_USERNAME=root
DB_PASSWORD=
# DB_SSLMODE=require   # diperlukan untuk Supabase

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Akun seeder (jangan isi nilai asli di repositori)
SEED_ADMIN_EMAIL=admin@galangkita.test
SEED_ADMIN_PASSWORD=
SEED_PETUGAS_PASSWORD=
SEED_DONATUR_PASSWORD=
# true = tambah donasi percobaan (Faker) agar dashboard dan laporan ada isinya
SEED_DEMO_DONASI=false

# Email kode verifikasi (ganti email / kata sandi).
# Lokal: MAIL_MAILER=log -> kode ada di storage/logs/laravel.log.
# Gmail: MAIL_MAILER=smtp, host smtp.gmail.com, port 587, tls, dan isi "App Password" Google (bukan password Gmail).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="halo@galangkita.test"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_EMAIL=

# Login Google (opsional). Redirect URI harus sama persis dengan yang didaftarkan di Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

VITE_APP_NAME="${APP_NAME}"
